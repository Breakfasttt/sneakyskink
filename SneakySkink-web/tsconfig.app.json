{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "vite/client": ["../node_modules/vite/client.d.ts"],
      "@mui/material": ["../node_modules/@mui/material"],
      "@mui/material/*": ["../node_modules/@mui/material/*"],
      "@mui/icons-material": ["../node_modules/@mui/icons-material"],
      "@mui/icons-material/*": ["../node_modules/@mui/icons-material/*"],
      "@emotion/react": ["../node_modules/@emotion/react"],
      "@emotion/styled": ["../node_modules/@emotion/styled"],
      "sneakyskink-api-client": ["../sneakyskink-api-client/src"],
      "*": ["*", "../node_modules/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
